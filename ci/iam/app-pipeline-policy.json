{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CommandsActionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:084519186805:log-group:/aws/codepipeline/*",
        "arn:aws:logs:ap-southeast-1:084519186805:log-group:/aws/codepipeline/*:log-stream:*"
      ]
    },
    {
      "Sid": "PipelineArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::codepipeline-ap-southeast-1-*",
        "arn:aws:s3:::codepipeline-ap-southeast-1-*/*"
      ]
    },
    {
      "Sid": "AppState",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::family-drive-tfstate-084519186805",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "family-drive/*"
          ]
        }
      }
    },
    {
      "Sid": "AppStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::family-drive-tfstate-084519186805/family-drive/*"
    },
    {
      "Sid": "ReadFoundationParams",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1:084519186805:parameter/family-drive/*"
    },
    {
      "Sid": "FilesBucketCorsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketCORS",
        "s3:PutBucketCORS"
      ],
      "Resource": "arn:aws:s3:::family-drive-files-084519186805"
    },
    {
      "Sid": "WebBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucket*",
        "s3:PutBucket*",
        "s3:DeleteBucketPolicy",
        "s3:GetAccelerateConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::family-drive-web-084519186805",
        "arn:aws:s3:::family-drive-web-084519186805/*"
      ]
    },
    {
      "Sid": "CloudFrontCreateDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:TagResource"
      ],
      "Resource": "arn:aws:cloudfront::084519186805:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "family-drive"
        }
      }
    },
    {
      "Sid": "CloudFrontOwnDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:CreateInvalidation",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::084519186805:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "family-drive"
        }
      }
    },
    {
      "Sid": "CloudFrontRead",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:GetInvalidation",
        "cloudfront:ListTagsForResource",
        "cloudfront:GetCachePolicy",
        "cloudfront:GetResponseHeadersPolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::084519186805:distribution/*",
        "arn:aws:cloudfront::*:cache-policy/*",
        "arn:aws:cloudfront::*:response-headers-policy/*"
      ]
    },
    {
      "Sid": "CloudFrontOriginAccessControl",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": "arn:aws:cloudfront::084519186805:origin-access-control/*"
    },
    {
      "Sid": "CloudFrontResponseHeadersPolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateResponseHeadersPolicy",
        "cloudfront:UpdateResponseHeadersPolicy",
        "cloudfront:DeleteResponseHeadersPolicy"
      ],
      "Resource": "arn:aws:cloudfront::084519186805:response-headers-policy/*"
    },
    {
      "Sid": "CloudFrontList",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListOriginAccessControls",
        "cloudfront:ListCachePolicies",
        "cloudfront:ListResponseHeadersPolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53CustomDomainRecords",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "A",
            "AAAA"
          ]
        }
      }
    },
    {
      "Sid": "Route53Read",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource"
      ],
      "Resource": "arn:aws:route53:::hostedzone/*"
    },
    {
      "Sid": "Route53Changes",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    },
    {
      "Sid": "Lambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:Get*",
        "lambda:List*",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-1:084519186805:function:family-drive-*"
    },
    {
      "Sid": "LambdaLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:084519186805:log-group:/aws/lambda/family-drive-*",
        "arn:aws:logs:ap-southeast-1:084519186805:log-group:/aws/lambda/family-drive-*:*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:ap-southeast-1:084519186805:log-group:*"
    }
  ]
}
