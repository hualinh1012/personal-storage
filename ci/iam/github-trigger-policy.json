{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndWatchOnePipeline",
      "Effect": "Allow",
      "Action": [
        "codepipeline:StartPipelineExecution",
        "codepipeline:GetPipelineExecution",
        "codepipeline:ListActionExecutions"
      ],
      "Resource": "arn:aws:codepipeline:__REGION__:__ACCOUNT_ID__:__PIPELINE__"
    }
  ]
}
